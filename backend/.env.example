# ============================================================
# Tweak Insight Logistics -- Backend Environment Configuration
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to ".env" (never commit ".env").
#   2. Replace every placeholder below with real production values.
#   3. For DB_PASS and JWT_SECRET use >= 32 bytes of cryptographically
#      random output from the production secret manager.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME="Tweak Insight Logistics"
APP_ENV=production                    # development | staging | production
APP_DEBUG=false                       # MUST BE false IN PRODUCTION
BASE_URL=https://logistics.example.com
SERVER_PORT=443

# ------------------------------------------------------------
# CORS / Allowed Frontend Origins
# Comma separated list. Include protocol + port if non-standard.
# ------------------------------------------------------------
ALLOWED_ORIGINS="https://logistics.example.com,https://www.logistics.example.com"

# ------------------------------------------------------------
# Database (MySQL 8.0+ -- utf8mb4)
# WARNING: NEVER use the MySQL "root" account. Create a dedicated
# least-privilege user with php scripts/provision_app_db_user.php.
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tweak_insight_logistics
DB_USER=til_app
DB_PASS=REPLACE_WITH_64_CHAR_RANDOM_HEX
DB_CHARSET=utf8mb4

# ------------------------------------------------------------
# JWT Access Token (HS256 secret).
# ------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_TTL_SECONDS=900                  # 15 minutes default
JWT_MAX_TTL_SECONDS=3600             # Absolute cap (1 hour)

# ------------------------------------------------------------
# Refresh Session Cookie
# ------------------------------------------------------------
AUTH_COOKIE_SAMESITE=Strict          # Strict | Lax | None (None requires HTTPS)
AUTH_COOKIE_SECURE=true              # MUST BE true ON ANY HTTPS DEPLOYMENT
AUTH_REFRESH_COOKIE_PATH=/api/auth   # Narrowest path that covers refresh endpoint

# ------------------------------------------------------------
# Rate Limiter + Job Queue + Cache Driver
# In production ALWAYS set these to "redis" and configure REDIS_URL below.
# ------------------------------------------------------------
RATE_LIMIT_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_DRIVER=redis

# ------------------------------------------------------------
# Redis (single-node / cluster auto-detect)
# ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_INDEX=0
REDIS_SCHEME=tcp

# ------------------------------------------------------------
# Notification Gateways (optional, leave blank to disable channel)
# ------------------------------------------------------------
# SMS -- Termii / Africa's Talking / Twilio
SMS_GATEWAY=termii
SMS_API_KEY=
SMS_SENDER_ID=TIL
SMS_BASE_URL=https://api.ng.termii.com/api

# WhatsApp Business -- Meta / Twilio sandbox
WHATSAPP_GATEWAY=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Email -- Postmark / SMTP
MAIL_MAILER=postmark
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@logistics.example.com"
MAIL_FROM_NAME="Tweak Insight Logistics"

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=

# ------------------------------------------------------------
# Geocoding + Map Tiles
# ------------------------------------------------------------
GEOCODER_PROVIDER=opencage            # opencage | google | nominatim
GEOCODER_API_KEY=

# ------------------------------------------------------------
# Payment Processing (Paystack / Flutterwave)
# ------------------------------------------------------------
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# ------------------------------------------------------------
# Secure document storage
# Production requires a private S3/R2-compatible bucket. Local disk is
# development-only and is streamed through the authorization layer.
# ------------------------------------------------------------
STORAGE_DRIVER=s3                    # production: s3; development only: local
STORAGE_PATH=storage

# S3 / Cloudflare R2 / MinIO (private bucket only)
S3_ENDPOINT=REPLACE_WITH_HTTPS_S3_ENDPOINT
S3_BUCKET=REPLACE_WITH_PRIVATE_KYC_BUCKET
S3_REGION=auto
S3_KEY=REPLACE_WITH_OBJECT_STORAGE_KEY
S3_SECRET=REPLACE_WITH_OBJECT_STORAGE_SECRET
S3_SERVER_SIDE_ENCRYPTION=aws:kms    # AES256 | aws:kms
S3_KMS_KEY_ID=
S3_URL_EXPIRES=300                   # clamped to 60–300 seconds
# Malware scanning and legal retention are mandatory in production.
UPLOAD_SCAN_DRIVER=clamav
CLAMAV_BINARY=/usr/bin/clamscan
KYC_DOCUMENT_RETENTION_DAYS=REPLACE_WITH_APPROVED_RETENTION_DAYS
