# ==============================================================================
# Stage 1: Build the React frontend SPA
# ==============================================================================
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci --prefer-offline

COPY frontend/ ./
ENV CI=false
ENV REACT_APP_API_BASE_URL=/api
RUN npm run build

# ==============================================================================
# Stage 2: Production — FrankenPHP (PHP 8.3 + Caddy)
# ==============================================================================
FROM dunglas/frankenphp:1-php8.3-alpine

# Install required PHP extensions
RUN install-php-extensions pdo_mysql bcmath opcache intl zip

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copy built React SPA
COPY --from=frontend-builder /app/frontend/build /app/public

# Copy PHP backend
COPY backend /app/backend

# Install PHP Composer dependencies (no dev)
RUN cd /app/backend \
    && composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

# Create a thin PHP stub in /app/public/index.php
# Caddy's php_server directive will invoke this for /api/* routes
RUN printf '<?php\nrequire_once "/app/backend/api/index.php";\n' > /app/public/index.php

# Copy Caddy configuration
COPY Caddyfile /etc/caddy/Caddyfile

# Create writable temp storage
RUN mkdir -p /tmp/storage/logs /tmp/storage/cache /tmp/storage/uploads \
        /tmp/storage/client-kyc /tmp/storage/driver-documents \
    && chmod -R 777 /tmp/storage

# Runtime environment defaults
ENV STORAGE_PATH=/tmp/storage
ENV QUEUE_DRIVER=mysql
ENV APP_ENV=production
ENV APP_DEBUG=false

# Vercel sets PORT — Caddy reads it from $PORT (see Caddyfile)
EXPOSE 80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
