{
    frankenphp
    order frankenphp before file_server
    admin off
    auto_https off
}

:{$PORT:80} {
    log {
        output stderr
        format console
    }

    root * /app/public
    encode zstd gzip

    # Route /api/* requests to PHP entrypoint
    handle /api/* {
        php_server {
            try_files {path} /index.php
        }
    }

    # Serve physical static assets directly
    @static {
        file
        not path *.php
    }

    handle @static {
        file_server
    }

    # SPA Fallback: Any other URL serves index.html for client-side routing
    handle {
        try_files {path} /index.html
        file_server
    }
}
