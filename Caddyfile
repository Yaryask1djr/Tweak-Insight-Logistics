{
	frankenphp
	order frankenphp before file_server
	admin off
	auto_https off
}

# Vercel sets $PORT dynamically; default to 80
:{$PORT:80} {
	log {
		output stderr
		format console
	}

	root * /app/public
	encode zstd gzip

	# PHP API — pass full URI (including /api prefix) to PHP
	# The PHP router in backend/api/index.php strips /api itself
	handle /api/* {
		root * /app/public
		php_server
	}

	# Serve real static files directly
	handle {
		try_files {path} /index.html
		file_server
	}
}
