{
	frankenphp
	admin off
	auto_https off
}

:{$PORT} {
	log {
		output stderr
		format console
	}

	root * /app/public
	encode zstd gzip

	# PHP API routes
	handle /api/* {
		php_server {
			try_files {path} index.php
		}
	}

	# Frontend SPA routes and static assets
	handle {
		try_files {path} /index.html
		file_server
	}
}
