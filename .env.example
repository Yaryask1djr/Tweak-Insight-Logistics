# ==============================================================================
# Tweak Insight Logistics - Master Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
#   - For Docker deployment: cp .env.example .env (uses container hostnames db, redis)
#   - For VPS / Bare-Metal deployment: cp .env.example backend/.env (uses 127.0.0.1)
# ==============================================================================

# Application Environment
APP_NAME="Tweak Insight Logistics"
APP_ENV=production
APP_DEBUG=false
BASE_URL=https://logistics.tweakinsight.com
ALLOWED_ORIGINS="https://logistics.tweakinsight.com,https://www.logistics.tweakinsight.com"

# Web Ports (Docker Host Binding)
PORT=80
SSL_PORT=443

# Database Connection (MySQL 8.0+)
# For Docker Compose use: DB_HOST=db
# For Cloud VPS / Bare Metal use: DB_HOST=127.0.0.1
DB_HOST=db
DB_PORT=3306
DB_NAME=tweak_insight_logistics
DB_USER=til_app
DB_PASS=til_super_secure_db_pass_replace_in_prod
DB_ROOT_PASSWORD=til_root_password_replace_in_prod
DB_CHARSET=utf8mb4

# High-Concurrency Cache, Rate Limiting & Queue (Redis 7)
# For Docker Compose use: REDIS_HOST=redis
# For Cloud VPS / Bare Metal use: REDIS_HOST=127.0.0.1
RATE_LIMIT_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_INDEX=0

# Security Tokens & Cryptography (Generate 64 hex characters: openssl rand -hex 32)
JWT_SECRET=4f8b9e1d2c3a5f6e7b8a9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f
JWT_TTL_SECONDS=900
JWT_MAX_TTL_SECONDS=3600

# Refresh Session Cookies
AUTH_COOKIE_SAMESITE=Strict
AUTH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_PATH=/api/auth

# Automated Initial Migration & Seeding
RUN_MIGRATIONS=true
SEED_DEMO=false

# Queue Worker Settings
QUEUE_NAME=default
WORKER_SLEEP=2
WORKER_MEMORY=128
WORKER_MAX_JOBS=1000

# Geocoder Service (OpenCage, Google, or Nominatim)
GEOCODER_PROVIDER=nominatim
GEOCODER_API_KEY=

# Payment Gateway (Paystack / Flutterwave)
PAYMENT_PROVIDER=paystack
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_RETURN_URL=https://logistics.tweakinsight.com/payment/return

# External SMS & WhatsApp Notifications
SMS_GATEWAY=termii
SMS_API_KEY=
SMS_SENDER_ID=TIL
WHATSAPP_GATEWAY=

# Object Storage (S3 / Cloudflare R2 / MinIO for KYC verification documents)
STORAGE_DRIVER=local
STORAGE_PATH=storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_KEY=
S3_SECRET=
