# ============================================================
# Tweak Insight Logistics -- Frontend Environment Configuration
# ============================================================
# CRA convention: Variables MUST start with REACT_APP_ to be bundled.
# Copy to ".env" (development), ".env.production", etc. as needed.
# NEVER commit the .env file itself -- only commit this template.

# ------------------------------------------------------------
# API Backend Base URL
#   Development: http://localhost:8000 (PHP dev server port)
#   Production : /api            (same-origin nginx/Apache proxy)
# ------------------------------------------------------------
REACT_APP_API_BASE_URL=/api

# ------------------------------------------------------------
# Public site URL (used for shareable tracking links)
# ------------------------------------------------------------
REACT_APP_PUBLIC_URL=https://logistics.example.com

# ------------------------------------------------------------
# Map tile provider.  Default is OSM (free).
# For production register at Mapbox / Stadia and add token.
# ------------------------------------------------------------
REACT_APP_MAP_PROVIDER=osm           # osm | mapbox | stadia
REACT_APP_MAP_ACCESS_TOKEN=

# ------------------------------------------------------------
# Notification / PWA VAPID keys (if enabling browser push)
# ------------------------------------------------------------
REACT_APP_VAPID_PUBLIC_KEY=

# ------------------------------------------------------------
# Analytics / Error reporting
# ------------------------------------------------------------
REACT_APP_SENTRY_DSN=
REACT_APP_GA_MEASUREMENT_ID=

# ------------------------------------------------------------
# Demo / Showcase mode.  When true the UI hides some
# destructive-action buttons and shows banner notice.
# ------------------------------------------------------------
REACT_APP_DEMO_MODE=false
