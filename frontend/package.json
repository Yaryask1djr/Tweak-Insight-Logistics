{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.6.8",
    "bootstrap": "^5.3.3",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.4"
  },
  "proxy": "http://localhost:8000",
  "scripts": {
    "dev": "concurrently \"cd ../backend && php -S localhost:8000 router.php\" \"cross-env PORT=3000 react-scripts start\"",
    "start": "cross-env PORT=3000 react-scripts start",
    "start:prod": "cd ../backend && php -S localhost:8000 router.php",
    "build": "react-scripts build",
    "build:backend": "node scripts/deploy-backend-build.js --prepare",
    "test": "react-scripts test",
    "lint": "eslint src --max-warnings=0",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "react-scripts": "5.0.1",
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  }
}
